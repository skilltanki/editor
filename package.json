{
  "name": "skilltanki-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "predev": "node scripts/sync-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "prepreview": "node scripts/sync-assets.mjs",
    "preview": "vite preview",
    "build:deploy": "tsc --noEmit && VITE_ASSET_BASE=/assets/ vite build",
    "upload-assets": "node scripts/upload-assets.mjs"
  },
  "dependencies": {
    "playcanvas": "2.23.1"
  },
  "devDependencies": {
    "javascript-obfuscator": "^5.9.0",
    "terser": "^5.51.2",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
